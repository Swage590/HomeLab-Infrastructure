services:
  postgres:
    image: postgres:16-alpine
    container_name: n8n-postgres
    restart: always
    environment:
      - POSTGRES_USER=n8n
      - POSTGRES_PASSWORD={{ n8n_postgres_password }}
      - POSTGRES_DB=n8n
    volumes:
      - n8n_postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ['CMD-SHELL', 'pg_isready -h localhost -U n8n -d n8n']
      interval: 5s
      timeout: 5s
      retries: 10

  n8n:
    image: docker.n8n.io/n8nio/n8n
    container_name: n8n-main
    restart: always
    ports:
      - "5678:5678"
    environment:
      # --- Database Configuration ---
      - DB_TYPE=postgresdb
      - DB_POSTGRESDB_DATABASE=n8n
      - DB_POSTGRESDB_HOST=postgres
      - DB_POSTGRESDB_PORT=5432
      - DB_POSTGRESDB_USER=n8n
      - DB_POSTGRESDB_PASSWORD={{ n8n_postgres_password }}

      # --- System Performance / Pruning ---
      - N8N_DEFAULT_BINARY_DATA_MODE=filesystem # Stops large files from eating your RAM
      - EXECUTIONS_DATA_PRUNE=true
      - EXECUTIONS_DATA_MAX_AGE=168 # Auto-deletes logs older than 7 days

      # --- Your Existing Configuration ---
      - N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
      - N8N_HOST=n8n.swages.net
      - N8N_PORT=5678
      - N8N_PROTOCOL=https
      - NODE_ENV=production
      - WEBHOOK_URL=https://n8n.swages.net/
      - GENERIC_TIMEZONE=America/New_York
      - TZ=America/New_York
      - N8N_RUNNERS_MODE=external
      - N8N_RUNNERS_BROKER_LISTEN_ADDRESS=0.0.0.0
      - N8N_RUNNERS_AUTH_TOKEN={{ n8n_runner_password }}
      - N8N_NATIVE_PYTHON_RUNNER=true
    volumes:
      - /home/{{ ansible_user }}/n8n/n8n_data:/home/node/.n8n
      - /home/{{ ansible_user }}/n8n/local-files:/files
    depends_on:
      postgres:
        condition: service_healthy

  task-runners:
    image: n8nio/runners:1.111.0
    container_name: n8n-runners
    restart: unless-stopped
    environment:
      - N8N_RUNNERS_TASK_BROKER_URI=http://n8n-main:5679
      - N8N_RUNNERS_AUTH_TOKEN={{ n8n_runner_password }}
    depends_on:
      - n8n

volumes:
  n8n_postgres_data:
